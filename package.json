{
  "name": "forskoleguiden",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "astro check",
      "eslint --no-warn-ignored"
    ],
    "*.md": "markdownlint-cli2",
    "*": "prettier --check --ignore-unknown"
  },
  "scripts": {
    "audit:lighthouse": "lhci autorun",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "prepare": "husky",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --config=playwright.webkit.config.ts",
    "test:post-build": "vitest run --config vitest.post-build.config.ts",
    "test:watch": "vitest",
    "validate": "pnpm lint && pnpm lint:md && pnpm format && pnpm check && pnpm test && pnpm build && pnpm test:post-build && pnpm test:e2e && pnpm test:e2e:webkit && pnpm audit:lighthouse"
  },
  "dependencies": {
    "@astrojs/preact": "5.1.3",
    "@fontsource-variable/inter": "5.2.8",
    "@nanostores/preact": "1.1.0",
    "astro": "6.3.5",
    "lz-string": "1.5.0",
    "nanostores": "1.3.0",
    "preact": "10.29.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.2",
    "@axe-core/playwright": "4.11.3",
    "@eslint/compat": "2.1.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.60.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-better-tailwindcss": "4.5.0",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.0.5",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.3",
    "vitest": "4.1.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.3"
    }
  }
}
