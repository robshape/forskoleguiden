---
import Nav from '@/components/astro/Nav.astro'
import Footer from '@/components/astro/Footer.astro'
import type { Locale } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import '@/styles/global.css'

interface Props {
  title: string
  locale: Locale
}

const { title, locale } = Astro.props
const base = getBasePath()
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body
    class="bg-page font-sans text-gray-900 min-h-screen flex flex-col antialiased"
  >
    <header>
      <Nav locale={locale} />
    </header>
    <main class="flex-1">
      <div class="max-w-content mx-auto px-5 pt-5 pb-8">
        <slot />
      </div>
    </main>
    <footer>
      <Footer locale={locale} />
    </footer>
  </body>
</html>
