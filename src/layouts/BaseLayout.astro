---
import '@fontsource-variable/inter'
import '@/styles/global.css'

import Footer from '@/components/astro/Footer.astro'
import Nav from '@/components/astro/Nav.astro'
import CompareTray from '@/components/preact/CompareTray'
import { DEFAULT_LOCALE, type Locale, LOCALES, t } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import { buildLocaleSwitchUrl, isRtlLocale } from '@/lib/locale-switch'

interface Props {
  description?: string
  locale: Locale
  title: string
}

const { description, locale, title } = Astro.props

const base = getBasePath()
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const alternateUrls = LOCALES.map((loc) => ({
  href: new URL(buildLocaleSwitchUrl(Astro.url.pathname, loc, base), Astro.site)
    .href,
  hreflang: loc,
}))
const xDefaultUrl = alternateUrls.find((a) => a.hreflang === DEFAULT_LOCALE)
if (!xDefaultUrl) {
  throw new Error(
    `[BaseLayout] Missing alternate URL for default locale "${DEFAULT_LOCALE}". Ensure DEFAULT_LOCALE is included in LOCALES.`,
  )
}
const compareHref = `${base}/${locale}/jamfor/`
// Discover which locales have a compare page at build time. If the page
// structure is reorganised (e.g. `/jamfor/` is renamed), this glob must be
// updated to match the new path — otherwise the compare tray link breaks
// silently. See: src/pages/*/jamfor/index.astro
const comparePages = import.meta.glob('/src/pages/*/jamfor/index.astro')
const compareRouteAvailable =
  `/src/pages/${locale}/jamfor/index.astro` in comparePages
const isOnComparePage = Astro.url.pathname.includes('/jamfor')
---

<!doctype html>
<html dir={isRtlLocale(locale) ? 'rtl' : undefined} lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <link href={`${base}/favicon.svg`} rel="icon" type="image/svg+xml" />
    <meta content="width=device-width, viewport-fit=cover" name="viewport" />
    <title>{title}</title>
    {description && <meta content={description} name="description" />}
    <meta content={title} property="og:title" />
    {description && <meta content={description} property="og:description" />}
    <meta content={canonicalUrl.href} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={locale} property="og:locale" />
    <link href={canonicalUrl.href} rel="canonical" />
    {
      alternateUrls.map(({ href, hreflang }) => (
        <link href={href} hreflang={hreflang} rel="alternate" />
      ))
    }
    <link href={xDefaultUrl.href} hreflang="x-default" rel="alternate" />
  </head>
  <body
    class="flex min-h-screen flex-col overflow-x-hidden bg-page font-sans text-gray-900 antialiased"
  >
    <header>
      <Nav locale={locale} />
    </header>
    <main class="flex-1">
      <div
        class="mx-auto max-w-content px-4 pt-5 pb-12 sm:px-6 sm:pt-8 sm:pb-16"
        data-testid="content-container"
      >
        <slot />
      </div>
    </main>
    <footer>
      <Footer locale={locale} />
    </footer>
    <CompareTray
      clearLabel={t('compareTray.clear', locale)}
      client:only="preact"
      compareHref={compareHref}
      compareRouteAvailable={compareRouteAvailable}
      directoryHref={`${base}/${locale}/`}
      isOnComparePage={isOnComparePage}
      locale={locale}
      selectedCountTemplate={t('compareTray.selectedCount', locale)}
      showComparisonLabel={t('compareTray.showComparison', locale)}
    />
  </body>
</html>

<script>
  // Shared dismiss handler for all <details data-dismissible> dropdowns.
  // Closes on click-outside and Escape key (WCAG 2.1 SC 1.4.13).
  document.addEventListener('click', (event: MouseEvent) => {
    const target = event.target as Node
    document
      .querySelectorAll<HTMLDetailsElement>('details[data-dismissible][open]')
      .forEach((details) => {
        if (!details.contains(target)) {
          details.removeAttribute('open')
        }
      })
  })

  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape') {
      document
        .querySelectorAll<HTMLDetailsElement>('details[data-dismissible][open]')
        .forEach((details) => {
          details.removeAttribute('open')
          details.querySelector('summary')?.focus()
        })
    }
  })
</script>
