---
import Nav from '@/components/astro/Nav.astro'
import Footer from '@/components/astro/Footer.astro'
import CompareTray from '@/components/preact/CompareTray'
import { t, type Locale } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import '@/styles/global.css'

interface Props {
  title: string
  locale: Locale
}

const { title, locale } = Astro.props
const base = getBasePath()
const compareHref = `${base}/${locale}/jamfor/`
const selectedCountTemplate = t('compareTray.selectedCount', locale)
const showComparisonLabel = t('compareTray.showComparison', locale)
const clearLabel = t('compareTray.clear', locale)

// Detect at build time whether the compare page route exists for the current
// locale. The tray uses this to decide between a live link and a disabled button.
const comparePages = import.meta.glob('/src/pages/*/jamfor/index.astro')
const compareRouteAvailable =
  `/src/pages/${locale}/jamfor/index.astro` in comparePages
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body
    class="flex min-h-screen flex-col bg-page font-sans text-gray-900 antialiased"
  >
    <header>
      <Nav locale={locale} />
    </header>
    <main class="flex-1">
      <div class="mx-auto max-w-content px-5 pt-5 pb-8">
        <slot />
      </div>
    </main>
    <footer>
      <Footer locale={locale} />
    </footer>
    <CompareTray
      client:only="preact"
      compareHref={compareHref}
      compareRouteAvailable={compareRouteAvailable}
      selectedCountTemplate={selectedCountTemplate}
      showComparisonLabel={showComparisonLabel}
      clearLabel={clearLabel}
    />
  </body>
</html>
