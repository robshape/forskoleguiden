---
import BreadcrumbLink from '@/components/preact/BreadcrumbLink'

interface Props {
  href: string
  label: string
  dynamicComparisonHref?: string
  dynamicComparisonLabel?: string
  isRtl?: boolean
}

const {
  href,
  label,
  dynamicComparisonHref,
  dynamicComparisonLabel,
  isRtl = false,
} = Astro.props
---

<nav aria-label={label} class="mt-2 mb-6" data-breadcrumb>
  <BreadcrumbLink
    client:load
    comparisonHref={dynamicComparisonHref}
    comparisonLabel={dynamicComparisonLabel}
    defaultHref={href}
    defaultLabel={label}
    isRtl={isRtl}
  />
</nav>
