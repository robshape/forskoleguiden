---
import { t, type Locale } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const base = getBasePath()
---

<nav
  aria-label={t('nav.ariaLabel', locale)}
  class="bg-surface border-b border-border"
>
  <div class="mx-auto flex h-nav w-full max-w-content items-center px-5">
    <a href={`${base}/${locale}/`} class="text-xl font-bold text-start">
      {t('site.title', locale)}
    </a>
    <span
      class="ms-auto flex h-7 min-w-[75px] cursor-default items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-700"
      title={t('nav.languageComingSoon', locale)}
      aria-disabled="true"
    >
      {t('nav.languagePlaceholder', locale)}
    </span>
  </div>
</nav>
