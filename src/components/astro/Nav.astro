---
import { t, type Locale } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<nav
  aria-label={t('nav.ariaLabel', locale)}
  class="bg-surface border-b border-border"
>
  <div class="mx-auto flex w-full max-w-content items-center gap-2 px-4 py-4">
    <a href={`/${locale}/`} class="text-xl font-bold text-start">
      Förskoleguiden
    </a>
    <span
      class="ms-auto bg-gray-100 rounded-full px-4 py-1 text-sm font-semibold"
    >
      {t('nav.languagePlaceholder', locale)}
    </span>
  </div>
</nav>
