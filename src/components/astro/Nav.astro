---
import CityYearSelector from '@/components/astro/CityYearSelector.astro'
import { type Locale, t } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const base = getBasePath()
---

<nav
  aria-label={t('nav.ariaLabel', locale)}
  class="border-b border-border bg-surface"
>
  <div class="mx-auto flex h-nav w-full max-w-content items-center gap-2 px-5">
    <a class="text-start text-xl font-bold" href={`${base}/${locale}/`}>
      {t('site.title', locale)}
    </a>
    <div class="ms-auto flex items-center gap-2">
      <CityYearSelector locale={locale} />
      <span
        aria-disabled="true"
        class="flex min-h-11 min-w-18.75 cursor-default items-center justify-center rounded-lg border border-border bg-gray-100 px-2.5 text-sm font-semibold text-gray-700"
        title={t('nav.languageComingSoon', locale)}
      >
        {t('nav.languagePlaceholder', locale)}
      </span>
    </div>
  </div>
</nav>
