---
import { t, type Locale } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<nav
  aria-label={t('nav.ariaLabel', locale)}
  class="bg-surface border-b border-border"
>
  <div class="mx-auto flex h-nav w-full max-w-content items-center px-5">
    <a href={`/${locale}/`} class="text-xl font-bold text-start">
      Förskoleguiden
    </a>
    <span
      class="ms-auto flex h-7 min-w-[75px] items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-700"
    >
      {t('nav.languagePlaceholder', locale)}
    </span>
  </div>
</nav>
