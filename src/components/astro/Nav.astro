---
import CitySelector from '@/components/astro/CitySelector.astro'
import LanguageSwitcher from '@/components/astro/LanguageSwitcher.astro'
import SearchPanel from '@/components/preact/SearchPanel'
import { type Locale, t } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import { getSearchablePreschools } from '@/lib/data'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const base = getBasePath()

const searchablePreschools = getSearchablePreschools()
---

<nav
  aria-label={t('nav.ariaLabel', locale)}
  class="border-b border-border bg-surface"
>
  <div class="mx-auto flex h-nav w-full max-w-content items-center gap-2 px-5">
    <a class="text-start text-xl font-bold" href={`${base}/${locale}/`}>
      {t('site.title', locale)}
    </a>
    <div class="ms-auto flex items-center gap-2">
      <SearchPanel
        addedLabel={t('preschoolCard.addedToCompare', locale)}
        addLabel={t('preschoolCard.addToCompare', locale)}
        basePath={base}
        client:only="preact"
        closeAriaLabel={t('search.closeAriaLabel', locale)}
        compareButtonAriaLabelTemplate={t(
          'preschoolCard.compareButtonAriaLabel',
          locale,
        )}
        locale={locale}
        noResultsText={t('search.noResults', locale)}
        placeholder={t('search.placeholder', locale)}
        resultCountTemplate={t('search.resultCount', locale)}
        resultsAriaLabel={t('search.resultsAriaLabel', locale)}
        searchablePreschools={searchablePreschools}
        triggerAriaLabel={t('search.triggerAriaLabel', locale)}
      />
      <CitySelector locale={locale} />
      <LanguageSwitcher locale={locale} />
    </div>
  </div>
</nav>
