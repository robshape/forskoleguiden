---
import { type Locale, t } from '@/i18n/utils'
import {
  CHECK_16_FILL_PATH,
  CHEVRON_DOWN_16_FILL_PATH,
  LOCK_16_FILL_PATH,
} from '@/lib/icons'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

// MVP fixture: only Malmö is active. When Phase 3 adds multi-city support,
// replace this hard-coded list with a data-driven approach from data/.
const disabledCities = [
  { key: 'stockholm' as const },
  { key: 'goteborg' as const },
]
---

<details class="relative" data-dismissible data-testid="header-city-dropdown">
  <summary
    aria-label={t('cityYear.heading', locale)}
    class="flex min-h-11 min-w-11 cursor-pointer list-none items-center gap-1.5 rounded-lg border border-border bg-surface px-3 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none active:bg-gray-100"
    data-testid="header-city-toggle"
    title={t('cityYear.heading', locale)}
  >
    <span>{t('cityYear.cities.malmo', locale)}</span>
    <svg
      aria-hidden="true"
      class="size-4 text-gray-700"
      fill="currentColor"
      viewBox="0 0 16 16"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        clip-rule="evenodd"
        d={CHEVRON_DOWN_16_FILL_PATH}
        fill-rule="evenodd"></path>
    </svg>
  </summary>

  <ul
    class="absolute inset-e-0 z-30 mt-2 w-40 space-y-1 rounded-lg border border-border bg-surface p-1.5 shadow-lg"
    data-testid="header-city-options"
    role="list"
  >
    <li>
      <button
        aria-current="true"
        class="inline-flex min-h-11 w-full items-center gap-1.5 rounded-md border border-primary-300 bg-primary-50 px-2.5 py-2 text-sm font-semibold text-primary-700 transition-colors"
        onclick="this.closest('details').removeAttribute('open')"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="size-3.5"
          fill="currentColor"
          viewBox="0 0 16 16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path clip-rule="evenodd" d={CHECK_16_FILL_PATH} fill-rule="evenodd"
          ></path>
        </svg>
        {t('cityYear.cities.malmo', locale)}
      </button>
    </li>
    {
      disabledCities.map((city) => (
        <li>
          <button
            class="inline-flex min-h-11 w-full cursor-not-allowed items-center gap-1.5 rounded-md border border-border bg-gray-100 px-2.5 py-2 text-sm font-medium text-gray-700"
            disabled
            type="button"
          >
            <svg
              aria-hidden="true"
              class="size-3.5 opacity-75"
              fill="currentColor"
              viewBox="0 0 16 16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                clip-rule="evenodd"
                d={LOCK_16_FILL_PATH}
                fill-rule="evenodd"
              />
            </svg>
            {t(`cityYear.cities.${city.key}`, locale)}
          </button>
        </li>
      ))
    }
  </ul>
</details>
