---
import DetailsBarChart from '@/components/preact/DetailsBarChart'
import { type Locale, t } from '@/i18n/utils'
import { computeAgreeShare } from '@/lib/scoring'
import { RESPONSE_ROWS } from '@/lib/survey-responses'
import type { SurveyQuestion } from '@/lib/types'

interface Props {
  question: SurveyQuestion
  locale: Locale
  index: number
}

const { question, locale, index } = Astro.props

const categoryLabels = RESPONSE_ROWS.map((row) => t(row.i18nKey, locale))
const agreeShare = Math.round(computeAgreeShare(question.response))
---

<li
  class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-xs transition-all hover:shadow-md sm:p-7"
>
  <h3 class="text-start text-base/relaxed font-semibold text-gray-900">
    "{question.text}"
  </h3>

  <div aria-hidden="true" class="mb-5">
    <DetailsBarChart
      categoryLabels={categoryLabels}
      chartIndex={index}
      response={question.response}
    />
  </div>

  <div
    aria-hidden="true"
    class="mt-auto flex items-center justify-end border-t border-gray-100 pt-3 rtl:justify-start"
  >
    <div
      class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-0.5 text-sm font-medium text-emerald-700"
    >
      <svg class="size-3.5" fill="currentColor" viewBox="0 0 20 20">
        <path
          d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
        ></path>
      </svg>
      {agreeShare}% {t('directory.scoreBadge.agreeShare', locale).toLowerCase()}
    </div>
  </div>

  <!-- Screen-reader accessible data table -->
  <table class="sr-only">
    <caption>{question.text}</caption>
    <tbody>
      {
        RESPONSE_ROWS.map((row) => (
          <tr>
            <th scope="row">{t(row.i18nKey, locale)}</th>
            <td>{question.response[row.field]}%</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</li>
