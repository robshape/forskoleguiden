---
import { type Locale, t } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const lockIconPath =
  'M8 1a3.5 3.5 0 0 0-3.5 3.5V7A1.5 1.5 0 0 0 3 8.5v5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 11.5 7V4.5A3.5 3.5 0 0 0 8 1Zm2 6V4.5a2 2 0 1 0-4 0V7h4Z'
const disabledCities = [
  { key: 'stockholm' as const },
  { key: 'goteborg' as const },
]
---

<section
  aria-label={t('cityYear.heading', locale)}
  class="flex flex-col gap-4 rounded-2xl border border-border bg-surface/90 p-4 shadow-sm sm:p-5"
>
  <div class="flex items-center gap-2">
    <p class="text-xs font-semibold tracking-[0.14em] text-gray-500 uppercase">
      {t('cityYear.heading', locale)}
    </p>
    <span aria-hidden="true" class="h-px flex-1 bg-border"></span>
  </div>

  <ul class="flex flex-wrap gap-2.5" role="list">
    <li>
      <button
        aria-current="true"
        class="inline-flex min-h-11 min-w-25 items-center justify-center rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-primary-700 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none active:bg-primary-700/90"
        type="button"
      >
        {t('cityYear.cities.malmo', locale)}
      </button>
    </li>
    {
      disabledCities.map((city) => (
        <li>
          <button
            aria-disabled="true"
            class="inline-flex min-h-11 min-w-25 cursor-not-allowed items-center justify-center gap-1.5 rounded-lg border border-border bg-gray-100 px-4 py-2 text-sm font-medium text-gray-500"
            disabled
            type="button"
          >
            <svg
              aria-hidden="true"
              class="size-3.5 opacity-75"
              fill="currentColor"
              viewBox="0 0 16 16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path clip-rule="evenodd" d={lockIconPath} fill-rule="evenodd" />
            </svg>
            {t(`cityYear.cities.${city.key}`, locale)}
          </button>
        </li>
      ))
    }
  </ul>
</section>
