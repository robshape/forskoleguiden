---
import { t, type Locale } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const lockIconPath =
  'M8 1a3.5 3.5 0 0 0-3.5 3.5V7A1.5 1.5 0 0 0 3 8.5v5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 11.5 7V4.5A3.5 3.5 0 0 0 8 1Zm2 6V4.5a2 2 0 1 0-4 0V7h4Z'

const disabledCities = [
  { key: 'stockholm' as const },
  { key: 'goteborg' as const },
]
---

<section aria-label={t('cityYear.heading', locale)} class="flex flex-col gap-4">
  <p class="text-sm font-semibold tracking-wide text-gray-500 uppercase">
    {t('cityYear.heading', locale)}
  </p>

  <ul class="flex flex-wrap gap-2.5" role="list">
    <li>
      <button
        type="button"
        aria-current="true"
        class="inline-flex min-w-25 items-center justify-center rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white"
      >
        {t('cityYear.cities.malmo', locale)}
      </button>
    </li>
    {
      disabledCities.map((city) => (
        <li>
          <button
            type="button"
            disabled
            aria-disabled="true"
            class="inline-flex min-w-25 cursor-not-allowed items-center justify-center gap-1.5 rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-400"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              fill="currentColor"
              class="size-3.5 opacity-75"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d={lockIconPath} clip-rule="evenodd" />
            </svg>
            {t(`cityYear.cities.${city.key}`, locale)}
          </button>
        </li>
      ))
    }
  </ul>
</section>
