---
import { type Locale, LOCALES, t } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import { CHECK_ICON_PATH, CHEVRON_DOWN_ICON_PATH } from '@/lib/icons'
import { buildLocaleSwitchUrl } from '@/lib/locale-switch'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const basePath = getBasePath()
const currentPath = Astro.url.pathname

const LOCALE_OPTIONS = LOCALES.map((code) => ({
  code,
})) satisfies ReadonlyArray<{ code: Locale }>
---

<nav aria-label={t('nav.languageSwitcherAriaLabel', locale)}>
  <details
    class="relative"
    data-dismissible
    data-testid="header-language-dropdown"
  >
    <summary
      class="flex min-h-11 min-w-11 cursor-pointer list-none items-center gap-1.5 rounded-lg border border-border bg-surface px-3 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none active:bg-gray-100"
      data-testid="header-language-toggle"
      title={t('nav.languageSwitcherAriaLabel', locale)}
    >
      <span class="hidden min-[376px]:inline" data-lang-label="full"
        >{t(`locale.${locale}`, locale)}</span
      >
      <span class="min-[376px]:hidden" data-lang-label="iso"
        >{locale.toUpperCase()}</span
      >
      <svg
        aria-hidden="true"
        class="size-4 text-gray-700"
        fill="currentColor"
        viewBox="0 0 16 16"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path clip-rule="evenodd" d={CHEVRON_DOWN_ICON_PATH} fill-rule="evenodd"
        ></path>
      </svg>
    </summary>

    <ul
      class="absolute inset-e-0 z-30 mt-2 min-w-max space-y-1 rounded-lg border border-border bg-surface p-1.5 shadow-lg"
      data-testid="header-language-options"
      role="list"
    >
      {
        LOCALE_OPTIONS.map((option) => {
          const isActive = option.code === locale
          const href = buildLocaleSwitchUrl(currentPath, option.code, basePath)
          const name = t(`locale.${option.code}`, locale)

          return (
            <li>
              {isActive ? (
                <button
                  aria-current="page"
                  class="inline-flex min-h-11 w-full items-center gap-1.5 rounded-md border border-primary-300 bg-primary-50 px-2.5 py-2 text-sm font-semibold whitespace-nowrap text-primary-700 transition-colors"
                  lang={option.code}
                  onclick="this.closest('details').removeAttribute('open')"
                  type="button"
                >
                  <span class="flex w-3.5 items-center justify-center">
                    <svg
                      aria-hidden="true"
                      class="size-3.5"
                      fill="currentColor"
                      viewBox="0 0 16 16"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        clip-rule="evenodd"
                        d={CHECK_ICON_PATH}
                        fill-rule="evenodd"
                      />
                    </svg>
                  </span>
                  <span>{name}</span>
                </button>
              ) : (
                <a
                  class="inline-flex min-h-11 w-full items-center gap-1.5 rounded-md border border-transparent px-2.5 py-2 text-sm font-medium whitespace-nowrap text-gray-700 transition-colors hover:bg-gray-100 hover:text-gray-900 focus-visible:bg-gray-100 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-1 focus-visible:outline-none active:bg-gray-200"
                  href={href}
                  lang={option.code}
                >
                  <span class="w-3.5" />
                  <span>{name}</span>
                </a>
              )}
            </li>
          )
        })
      }
    </ul>
  </details>
</nav>
