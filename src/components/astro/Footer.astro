---
import { type Locale, t } from '@/i18n/utils'
import { MALMO_SOURCE_URL, SURVEY_YEAR } from '@/lib/constants'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div
  class="mx-auto flex w-full max-w-content flex-col gap-1 py-6 ps-5 pe-5 text-sm text-gray-600 ltr:text-left rtl:text-right"
>
  <a
    class="text-primary-600 underline"
    href={MALMO_SOURCE_URL}
    referrerpolicy="no-referrer"
    rel="noopener noreferrer"
    target="_blank"
  >
    {t('attribution.text', locale, { year: String(SURVEY_YEAR) })}
  </a>
</div>
