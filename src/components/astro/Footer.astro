---
import { MALMO_SOURCE_URL, SURVEY_YEAR } from '@/lib/constants'
import { t, type Locale } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div
  class="mx-auto flex w-full max-w-content flex-col gap-1 py-6 ps-5 pe-5 text-sm text-gray-400 ltr:text-left rtl:text-right"
>
  <a
    href={MALMO_SOURCE_URL}
    target="_blank"
    rel="noopener noreferrer"
    referrerpolicy="no-referrer"
    class="text-primary-600 underline"
  >
    {t('attribution.text', locale, { year: String(SURVEY_YEAR) })}
  </a>
</div>
