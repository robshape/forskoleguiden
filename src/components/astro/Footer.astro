---
import { MALMO_SOURCE_URL } from '@/lib/constants'
import { t, type Locale } from '@/i18n/utils'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div class="border-t border-border">
  <p
    class="mx-auto w-full max-w-content ps-4 pe-4 py-4 text-sm text-gray-400 ltr:text-left rtl:text-right"
  >
    {t('attribution.text', locale)}
    <a
      href={MALMO_SOURCE_URL}
      rel="noopener noreferrer"
      referrerpolicy="no-referrer"
      class="text-primary-600 underline"
    >
      {t('attribution.sourceLinkLabel', locale)}
    </a>
  </p>
</div>
