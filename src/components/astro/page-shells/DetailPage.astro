---
import Breadcrumb from '@/components/astro/Breadcrumb.astro'
import QuestionCard from '@/components/astro/QuestionCard.astro'
import CompareButton from '@/components/preact/CompareButton'
import type { Locale } from '@/i18n/utils'
import { t } from '@/i18n/utils'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getBasePath } from '@/lib/base-path'
import { isRtlLocale } from '@/lib/locale-switch'
import { OVERALL_ASSESSMENT_GROUP } from '@/lib/scoring'
import type { PreschoolIndexEntry, PreschoolSurvey } from '@/lib/types'

interface Props {
  locale: Locale
  preschool: PreschoolIndexEntry
  survey: PreschoolSurvey
}

const { locale, preschool, survey } = Astro.props
const overallAssessmentGroup = survey.questionGroups.find(
  (group) => group.name === OVERALL_ASSESSMENT_GROUP,
)

const base = getBasePath()

const backLabel = t('compare.actions.backToDirectory', locale)
const backToComparisonLabel = t('compare.actions.backToComparison', locale)
const comparisonHref = `${base}/${locale}/jamfor/`
const directoryHref = `${base}/${locale}/`
const pageDescription = t('detail.metaDescription', locale, {
  name: preschool.name,
})
---

<BaseLayout
  description={pageDescription}
  locale={locale}
  title={preschool.name}
>
  <div class="mx-auto max-w-2xl">
    <Breadcrumb
      dynamicComparisonHref={comparisonHref}
      dynamicComparisonLabel={backToComparisonLabel}
      href={directoryHref}
      isRtl={isRtlLocale(locale)}
      label={backLabel}
    />

    <!-- Hero Section -->
    <header class="mb-12 flex flex-col gap-5 sm:gap-6">
      <h1
        class="text-start text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"
      >
        {preschool.name}
      </h1>

      <!-- Metadata -->
      <div
        class="flex flex-wrap items-center gap-x-4 gap-y-2 text-base font-medium text-gray-700"
      >
        <div class="flex items-center gap-1.5">
          <svg
            aria-hidden="true"
            class="size-4 shrink-0 text-emerald-600"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {preschool.address}
        </div>
        <span aria-hidden="true" class="text-gray-300 select-none">•</span>
        <div class="flex items-center gap-1.5">
          <svg
            aria-hidden="true"
            class="size-4 shrink-0 text-blue-600"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {t(`directory.operatorType.${preschool.operatorType}`, locale)}
        </div>
      </div>

      <!-- Actions -->
      <div class="mt-2 flex flex-wrap items-center gap-3 sm:w-auto">
        <CompareButton
          addedLabel={t('directory.addedToCompare', locale)}
          addLabel={t('directory.addToCompare', locale)}
          ariaLabelTemplate={t('directory.compareButtonAriaLabel', locale)}
          client:only="preact"
          id={preschool.id}
          name={preschool.name}
        />
        {
          preschool.operatorType === 'independent' &&
            preschool.queueUrl &&
            /^https?:\/\//.test(preschool.queueUrl) && (
              <a
                class="inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-full bg-white px-4 py-2 text-center text-caption/tight font-semibold text-primary-700 ring-1 ring-border transition-colors ring-inset hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-1 focus-visible:outline-none active:bg-gray-100"
                href={preschool.queueUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                <svg
                  aria-hidden="true"
                  class="size-3.5 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle
                    cx="9"
                    cy="7"
                    r="4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {t('detail.queueLink', locale)}
              </a>
            )
        }
        {
          survey.surveyPdfUrl && /^https:\/\//.test(survey.surveyPdfUrl) && (
            <a
              class="inline-flex min-h-11 shrink-0 items-center justify-center gap-1.5 rounded-full bg-white px-4 py-2 text-center text-caption/tight font-semibold text-primary-700 ring-1 ring-border transition-colors ring-inset hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-1 focus-visible:outline-none active:bg-gray-100"
              href={survey.surveyPdfUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              <svg
                aria-hidden="true"
                class="size-3.5 shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path
                  d="M7 21h10a2 2 0 002-2V9l-5-5H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M14 4v5h5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              {t('detail.surveyPdfLink', locale)}
            </a>
          )
        }
      </div>
    </header>

    {
      overallAssessmentGroup && (
        <section aria-labelledby="helhetsbedomning-heading" class="mt-8">
          <div class="mb-5 flex flex-col gap-1">
            <h2
              class="text-start text-xl font-bold tracking-tight text-gray-900"
              id="helhetsbedomning-heading"
            >
              {t('survey.results', locale)}
            </h2>
            <p class="text-base font-semibold text-gray-700">
              {overallAssessmentGroup.name}
            </p>
          </div>

          <ul class="grid auto-rows-[1fr] gap-5 sm:gap-6">
            {overallAssessmentGroup.questions.map((question, index) => (
              <QuestionCard index={index} locale={locale} question={question} />
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
