---
import { t, type Locale } from '@/i18n/utils'
import type { OperatorType } from '@/lib/types'

interface Props {
  id: string
  name: string
  address: string
  operatorType: OperatorType
  score: number | null
  locale: Locale
}

const { id, name, address, operatorType, score, locale } = Astro.props

const detailPageHref = `/${locale}/forskola/${id}/`
const operatorLabel = t(`directory.operatorType.${operatorType}`, locale)
const compareLabel = t('directory.addToCompare', locale)
const compareAriaLabel = t('directory.compareButtonAriaLabel', locale, {
  action: compareLabel,
  name,
})
const noOverallScoreText = t('directory.noOverallScore', locale)
const scorePercentText =
  score === null
    ? noOverallScoreText
    : t('directory.scorePercent', locale, {
        score,
      })
const scoreBadgeAgreeShareText = t('directory.scoreBadge.agreeShare', locale)
const scoreBadgeOverallAssessmentText = t(
  'directory.scoreBadge.overallAssessment',
  locale,
)

const scoreBadgeToneClass =
  score === null
    ? 'bg-gray-100 text-gray-600'
    : score >= 80
      ? 'bg-score-high-bg text-score-high-text'
      : score >= 65
        ? 'bg-score-medium-bg text-score-medium-text'
        : 'bg-gray-200 text-gray-800'
---

<article
  data-testid="preschool-card"
  class="rounded-xl border border-border bg-surface p-4 shadow-sm"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <h3 class="text-lg font-semibold leading-snug text-gray-900">
        <a
          href={detailPageHref}
          class="text-primary-700 underline-offset-2 hover:underline"
        >
          {name}
        </a>
      </h3>

      <p class="mt-2 text-sm text-gray-600">{address}</p>

      <p class="mt-3">
        <span
          class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700"
        >
          {operatorLabel}
        </span>
      </p>
    </div>

    <div class="shrink-0 text-right ltr:text-right rtl:text-left">
      <div class="flex items-center gap-3">
        <div
          class={`flex h-16 w-16 items-center justify-center rounded-full text-sm font-bold ${scoreBadgeToneClass}`}
        >
          {
            score === null ? (
              <>
                <span aria-hidden="true">—</span>
                <span class="sr-only">{noOverallScoreText}</span>
              </>
            ) : (
              scorePercentText
            )
          }
        </div>

        <p class="text-xs leading-tight text-gray-600">
          <span class="block">{scoreBadgeAgreeShareText}</span>
          <span class="block">{scoreBadgeOverallAssessmentText}</span>
        </p>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <button
      type="button"
      data-id={id}
      aria-label={compareAriaLabel}
      class="inline-flex h-10 items-center justify-center rounded-lg border border-border bg-gray-100 px-4 text-sm font-semibold text-gray-800"
    >
      {compareLabel}
    </button>
  </div>
</article>
