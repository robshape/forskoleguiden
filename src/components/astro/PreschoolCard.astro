---
import CompareButton from '@/components/preact/CompareButton'
import { type Locale, t } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import { SCORE_TIER_HIGH, SCORE_TIER_MEDIUM } from '@/lib/constants'
import type { OperatorType } from '@/lib/types'

interface Props {
  id: string
  name: string
  address: string
  operatorType: OperatorType
  score: number | null
  locale: Locale
}

const { id, name, address, operatorType, score, locale } = Astro.props
const displayScore = score !== null ? Math.round(score) : null

const base = getBasePath()
const detailPageHref = `${base}/${locale}/forskola/${id}/`

const noOverallScoreText = t('directory.noOverallScore', locale)
const scorePercentText =
  displayScore === null
    ? noOverallScoreText
    : t('directory.scorePercent', locale, {
        score: displayScore,
      })

const scoreBadgeToneClass =
  displayScore === null
    ? 'bg-gray-100 text-gray-600'
    : displayScore >= SCORE_TIER_HIGH
      ? 'bg-score-high-bg text-score-high-text'
      : displayScore >= SCORE_TIER_MEDIUM
        ? 'bg-score-medium-bg text-score-medium-text'
        : 'bg-gray-200 text-gray-800'
---

<article
  class="group relative flex min-w-0 flex-col gap-3 rounded-xl border border-border bg-linear-to-b from-surface to-white/90 p-4 shadow-sm transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md active:translate-y-0 active:scale-[0.99] sm:gap-4 sm:p-5"
  data-testid="preschool-card"
>
  <div class="min-w-0">
    <h3 class="text-base/snug font-bold tracking-tight text-gray-900">
      <a
        class="wrap-break-word text-gray-900 group-hover:text-primary-700 group-hover:underline before:absolute before:inset-0 before:z-0 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none"
        href={detailPageHref}
      >
        {name}
      </a>
    </h3>
    <p class="mt-1 text-base wrap-break-word text-gray-500">
      {t(`directory.operatorType.${operatorType}`, locale)} • {address}
    </p>
  </div>

  <div
    class="flex flex-wrap items-start justify-between gap-3 border-t border-border pt-3 sm:items-end"
  >
    <div class="flex min-w-0 flex-1 flex-row items-center gap-3">
      <div
        class={`flex h-11 min-w-11 shrink-0 items-center justify-center rounded-xl px-2 text-sm font-bold ${scoreBadgeToneClass}`}
      >
        {
          score === null ? (
            <>
              <span aria-hidden="true">—</span>
              <span class="sr-only" data-testid="score-fallback">
                {noOverallScoreText}
              </span>
            </>
          ) : (
            scorePercentText
          )
        }
      </div>

      <div class="flex min-w-0 flex-col text-left rtl:text-right">
        <span class="text-sm font-semibold text-gray-700">
          {t('directory.scoreBadge.agreeShare', locale)}
        </span>
        <span class="text-sm text-gray-500">
          {t('directory.scoreBadge.overallAssessment', locale)}
        </span>
      </div>
    </div>
    <div class="relative z-10 shrink-0">
      <CompareButton
        addedLabel={t('directory.addedToCompare', locale)}
        addLabel={t('directory.addToCompare', locale)}
        ariaLabelTemplate={t('directory.compareButtonAriaLabel', locale)}
        client:only="preact"
        id={id}
        name={name}
      />
    </div>
  </div>
</article>
