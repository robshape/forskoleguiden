---
import CompareButton from '@/components/preact/CompareButton'
import { t, type Locale } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import { SCORE_TIER_HIGH, SCORE_TIER_MEDIUM } from '@/lib/constants'
import type { OperatorType } from '@/lib/types'

interface Props {
  id: string
  name: string
  address: string
  operatorType: OperatorType
  score: number | null
  locale: Locale
}

const { id, name, address, operatorType, score, locale } = Astro.props
const displayScore = score !== null ? Math.round(score) : null

const base = getBasePath()
const detailPageHref = `${base}/${locale}/forskola/${id}/`

const noOverallScoreText = t('directory.noOverallScore', locale)
const scorePercentText =
  displayScore === null
    ? noOverallScoreText
    : t('directory.scorePercent', locale, {
        score: displayScore,
      })

const scoreBadgeToneClass =
  displayScore === null
    ? 'bg-gray-100 text-gray-600'
    : displayScore >= SCORE_TIER_HIGH
      ? 'bg-score-high-bg text-score-high-text'
      : displayScore >= SCORE_TIER_MEDIUM
        ? 'bg-score-medium-bg text-score-medium-text'
        : 'bg-gray-200 text-gray-800'
---

<article
  data-testid="preschool-card"
  class="group relative flex flex-col gap-4 rounded-xl border border-border bg-surface p-4 shadow-sm transition-all hover:border-primary-300 hover:shadow-md active:scale-[0.99]"
>
  <div>
    <h3 class="text-base/snug font-bold text-gray-900">
      <a
        href={detailPageHref}
        class="text-gray-900 group-hover:text-primary-700 group-hover:underline before:absolute before:inset-0 before:z-0 focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 focus-visible:outline-none"
      >
        {name}
      </a>
    </h3>
    <p class="mt-1 text-[13px] text-gray-500">
      {t(`directory.operatorType.${operatorType}`, locale)} • {address}
    </p>
  </div>

  <div class="flex items-center justify-between">
    <div class="flex flex-row items-center gap-3">
      <div
        class={`flex h-10 min-w-10 shrink-0 items-center justify-center rounded-lg px-2 text-sm font-bold ${scoreBadgeToneClass}`}
      >
        {
          score === null ? (
            <>
              <span aria-hidden="true">—</span>
              <span data-testid="score-fallback" class="sr-only">
                {noOverallScoreText}
              </span>
            </>
          ) : (
            scorePercentText
          )
        }
      </div>

      <div class="flex flex-col text-left rtl:text-right">
        <span class="text-[13px] font-medium text-gray-700">
          {t('directory.scoreBadge.agreeShare', locale)}
        </span>
        <span class="text-[11px] text-gray-500">
          {t('directory.scoreBadge.overallAssessment', locale)}
        </span>
      </div>
    </div>
    <div class="relative z-10">
      <CompareButton
        client:only="preact"
        id={id}
        name={name}
        addLabel={t('directory.addToCompare', locale)}
        addedLabel={t('directory.addedToCompare', locale)}
        ariaLabelTemplate={t('directory.compareButtonAriaLabel', locale)}
      />
    </div>
  </div>
</article>
