---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ComparisonView from '@/components/preact/ComparisonView'
import { t } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import { getAllPreschoolSurveys } from '@/lib/data'

const locale = 'sv'
const pageTitle = t('compare.heading', locale)

const base = getBasePath()
const directoryHref = `${base}/${locale}/`

const emptyStateTitle = t('compare.emptyStateTitle', locale)
const emptyStateBody = t('compare.emptyStateBody', locale)
const singleSelectionPrompt = t('compare.singleSelectionPrompt', locale)
const questionColumnLabel = t('compare.questionColumnLabel', locale)
const backToDirectoryLabel = t('compare.actions.backToDirectory', locale)

const surveys = getAllPreschoolSurveys()
---

<BaseLayout locale={locale} title={pageTitle}>
  <ComparisonView
    client:only="preact"
    heading={pageTitle}
    directoryHref={directoryHref}
    emptyStateTitle={emptyStateTitle}
    emptyStateBody={emptyStateBody}
    singleSelectionPrompt={singleSelectionPrompt}
    questionColumnLabel={questionColumnLabel}
    backToDirectoryLabel={backToDirectoryLabel}
    surveys={surveys}
  />
</BaseLayout>
