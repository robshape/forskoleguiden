---
import PreschoolCard from '@/components/astro/PreschoolCard.astro'
import SortToggle from '@/components/preact/SortToggle'
import { t } from '@/i18n/utils'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPreschoolIndex, getPreschoolSurveyByYear } from '@/lib/data'
import { byOverallScoreDesc, computeOverallScore } from '@/lib/scoring'

const locale = 'sv'
const preschoolIndex = getPreschoolIndex()
const surveyYear = preschoolIndex.year
const preschoolDirectory = preschoolIndex.preschools.map((preschool) => {
  const overallScore = computeOverallScore(
    getPreschoolSurveyByYear(preschool.id, surveyYear),
  )
  return {
    ...preschool,
    overallScore,
  }
})
const rankingSortedDirectory = [...preschoolDirectory].sort(
  (leftPreschool, rightPreschool) => {
    const byScore = byOverallScoreDesc(
      leftPreschool.overallScore,
      rightPreschool.overallScore,
    )

    if (byScore !== 0) {
      return byScore
    }

    return leftPreschool.name.localeCompare(rightPreschool.name, locale)
  },
)
const directoryWithRank = rankingSortedDirectory.map((preschool, index) => ({
  ...preschool,
  rankIndexZeroBased: index,
}))
const defaultSortedDirectory = [...directoryWithRank].sort(
  (leftPreschool, rightPreschool) =>
    leftPreschool.name.localeCompare(rightPreschool.name, locale),
)

const pageTitle = t('site.title', locale)
const directoryHeading = t('directory.heading', locale)
---

<BaseLayout locale={locale} title={pageTitle}>
  <section
    aria-label={t('directory.listAriaLabel', locale)}
    class="mt-2 space-y-6"
  >
    <div
      class="mb-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
        {`${directoryHeading} (${defaultSortedDirectory.length})`}
      </h1>
      <SortToggle
        alphabeticalLabel={t('directory.sort.alphabetical', locale)}
        client:load
        groupLabel={t('directory.sort.groupLabel', locale)}
        listId="sv-preschool-directory-list"
        locale={locale}
        rankingLabel={t('directory.sort.ranking', locale)}
        sortLabel={t('directory.sort.label', locale)}
      />
    </div>

    <ul class="space-y-3" id="sv-preschool-directory-list">
      {
        defaultSortedDirectory.map((preschool, index) => (
          <li
            class="block"
            data-name={preschool.name}
            data-rank-index-zero-based={preschool.rankIndexZeroBased}
          >
            <span class="sr-only" data-testid="rank-index">
              {index + 1}
            </span>
            <PreschoolCard
              address={preschool.address}
              id={preschool.id}
              locale={locale}
              name={preschool.name}
              operatorType={preschool.operatorType}
              score={preschool.overallScore}
            />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
