---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CityYearSelector from '@/components/astro/CityYearSelector.astro'
import PreschoolCard from '@/components/astro/PreschoolCard.astro'
import { t } from '@/i18n/utils'
import { getPreschoolIndex, getPreschoolSurveyByYear } from '@/lib/data'
import { computeOverallScore } from '@/lib/scoring'

const locale = 'sv'
const preschoolIndex = getPreschoolIndex()
const surveyYear = preschoolIndex.year
const pageTitle = t('site.title', locale)
const directoryListAriaLabel = t('directory.listAriaLabel', locale)

const preschoolDirectory = preschoolIndex.preschools.map((preschool) => {
  const overallScore = computeOverallScore(
    getPreschoolSurveyByYear(preschool.id, surveyYear),
  )

  return {
    ...preschool,
    overallScore,
  }
})
---

<BaseLayout locale={locale} title={pageTitle}>
  <CityYearSelector locale={locale} />

  <section aria-label={directoryListAriaLabel} class="mt-6">
    <ul class="space-y-2">
      {
        preschoolDirectory.map((preschool) => (
          <li>
            <PreschoolCard
              id={preschool.id}
              name={preschool.name}
              address={preschool.address}
              operatorType={preschool.operatorType}
              score={preschool.overallScore}
              locale={locale}
            />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
