---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CompareButton from '@/components/preact/CompareButton'
import { t } from '@/i18n/utils'
import { getBasePath } from '@/lib/base-path'
import { getPreschoolIndex, getPreschoolSurveyByYear } from '@/lib/data'
import type { PreschoolIndexEntry, PreschoolSurvey } from '@/lib/types'

interface Props {
  preschool: PreschoolIndexEntry
  survey: PreschoolSurvey
}

export function getStaticPaths() {
  const index = getPreschoolIndex()
  return index.preschools.map((preschool) => {
    const survey = getPreschoolSurveyByYear(preschool.id, index.year)
    return {
      params: { id: preschool.id },
      props: { preschool, survey },
    }
  })
}

const locale = 'sv'
const { preschool, survey } = Astro.props as Props

const base = getBasePath()
const operatorLabel = t(
  `directory.operatorType.${preschool.operatorType}`,
  locale,
)
const compareLabel = t('directory.addToCompare', locale)
const addedCompareLabel = t('directory.addedToCompare', locale)
const compareButtonAriaLabel = t('directory.compareButtonAriaLabel', locale)
const backLabel = t('compare.actions.backToDirectory', locale)
const surveyYearLabel = t('cityYear.surveyYear', locale)

const helhetsBedömning = survey.questionGroups.find(
  (group) => group.name === 'Helhetsbedömning',
)
---

<BaseLayout locale={locale} title={preschool.name}>
  <nav aria-label={backLabel}>
    <a
      href={`${base}/${locale}/`}
      class="inline-flex items-center gap-1 text-sm text-primary-700 hover:underline"
    >
      ← {backLabel}
    </a>
  </nav>

  <h1 class="mt-4 text-2xl font-bold text-gray-900">{preschool.name}</h1>

  <p class="mt-1 text-sm text-gray-600">
    {operatorLabel} • {preschool.address}
  </p>

  <p class="mt-1 text-sm text-gray-500">
    {surveyYearLabel}
    {survey.surveyYear}
  </p>

  <div class="mt-4">
    <CompareButton
      client:only="preact"
      id={preschool.id}
      name={preschool.name}
      addLabel={compareLabel}
      addedLabel={addedCompareLabel}
      ariaLabelTemplate={compareButtonAriaLabel}
    />
  </div>

  {
    helhetsBedömning && (
      <section class="mt-6" aria-labelledby="helhetsbedomning-heading">
        <h2
          id="helhetsbedomning-heading"
          class="text-lg font-semibold text-gray-900"
        >
          {helhetsBedömning.name}
        </h2>
        <ul class="mt-3 space-y-4">
          {helhetsBedömning.questions.map((question) => (
            <li class="rounded-lg border border-border bg-surface p-4">
              <p class="text-sm font-medium text-gray-800">{question.text}</p>
              <p class="mt-2 text-sm text-gray-600">
                {question.response.completelyAgreePercent}%{' '}
                {t('responses.completelyAgree', locale)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
